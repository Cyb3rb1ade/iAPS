APP_DISPLAY_NAME = iAPS
APP_VERSION = 8.3.6
APP_BUILD_NUMBER = 1
COPYRIGHT_NOTICE =
DEVELOPER_TEAM = C9RB6K683T
// Keep the ".diapi" suffix: it is the bundle ID Erik's installed build already uses.
// Changing it would install a second, empty app instead of upgrading the existing one.
BUNDLE_IDENTIFIER = ru.artpancreas.$(DEVELOPMENT_TEAM).FreeAPS.diapi
APP_GROUP_ID = group.com.$(DEVELOPMENT_TEAM).loopkit.LoopGroup

//Default App Icon, displayed at first installation.
APP_ICON = appIcon1

// Require authentication when bolusing.
AUTHENTICATE = true

// iAPS URL in other apps
APP_URL_SCHEME = freeaps-x

// Include file for overriding configuration
#include? "ConfigOverride.xcconfig"
//#include? "../../ConfigOverride.xcconfig"
